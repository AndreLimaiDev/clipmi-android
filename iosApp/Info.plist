<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Wajib untuk Compose Multiplatform (layar 120 Hz); tanpa ini ComposeUIViewController berhenti saat dibuka.
	     Kunci lain dibuat Xcode dari INFOPLIST_KEY_* di project.yml (GENERATE_INFOPLIST_FILE). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Folder Documents (project, log, crash.txt) terlihat di aplikasi Files; INFOPLIST_KEY_ untuk kunci ini tidak dibuat Xcode. -->
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
